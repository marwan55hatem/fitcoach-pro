APP_ENV=development
CORS_ORIGINS=["http://localhost:3001"]

DATABASE_URL=postgresql+psycopg://fitcoach:fitcoach@localhost:5433/fitcoach
JWT_SECRET=change-me-to-a-long-random-string

# Capacity per worker process (MAX_INFLIGHT_REQUESTS must be <= DB_POOL_SIZE + DB_MAX_OVERFLOW)
REQUEST_THREADS=32
DB_POOL_SIZE=16
DB_MAX_OVERFLOW=24
DB_POOL_TIMEOUT_S=10
MAX_INFLIGHT_REQUESTS=40
INFLIGHT_WAIT_S=1

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=fitcoach
S3_REGION=us-east-1

# AI provider (all calls go through app/ai/client.py)
AI_PROVIDER=openai
OPENAI_API_KEY=
# Leave the models empty to use the provider defaults (see app/ai/models.py)
AI_MODEL_MAIN=
AI_MODEL_VISION=
AI_MODEL_FAST=
AI_DAILY_TOKEN_BUDGET=300000
ANTHROPIC_API_KEY=

TELEGRAM_BOT_TOKEN=

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
RATE_LIMIT_AUTH=10/minute
